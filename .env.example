# ==============================================================================
# Harpy Growth Intelligence — Frontend & Full-Stack Environment Variables
# ==============================================================================

# API Base URL for Client HTTP Requests (proxied to http://localhost:5000 in dev)
VITE_API_BASE_URL=/api

# Application Metadata
VITE_APP_NAME="Harpy Growth Intelligence"
VITE_APP_VERSION=1.0.0
VITE_APP_DEFAULT_MARKETPLACE=US
VITE_APP_DEFAULT_CURRENCY=USD

# Server Configuration (For Express Backend)
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/harpy_analytics

# Amazon Selling Partner API (SP-API) Configuration (Stored in backend only, never exposed to client)
# SP_API_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxxxxxxxxxxxxxx
# SP_API_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SP_API_REFRESH_TOKEN=Atzr|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_REGION=us-east-1
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/HarpySpApiRole

# AI Growth Analyst Configuration (Backend only, never exposed to client)
# Optional: Provide an OpenAI API key for LLM natural-language reasoning;
# if omitted, Harpy Growth Intelligence falls back to its deterministic rule-based analyst engine.
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini


